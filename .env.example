# このファイルを .env へコピーし、値はローカルだけで設定する。
# .env はGit管理対象外。認証情報をチャットやコミットへ貼らないこと。
# ACCOUNT_ID は R2ダッシュボードの「S3 API」に出る32桁の16進へ置き換える。
# 置換し忘れると共有は無効のままで、起動ログに理由が出る。
# set_r2_endpoint.sh に貼り付ければ自動で書き換わる。
DS_SHEET_R2_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
# 実在するバケット名と完全に一致させること(不一致は AccessDenied になる)
DS_SHEET_R2_BUCKET=design-sheet-strage
DS_SHEET_R2_ACCESS_KEY_ID=
DS_SHEET_R2_SECRET_ACCESS_KEY=
DS_SHEET_R2_URL_TTL_S=86400
